# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Server only: never prefix these with NEXT_PUBLIC_ ---
# Supabase dashboard -> Project Settings -> API
# SUPABASE_URL defaults to NEXT_PUBLIC_SUPABASE_URL when not set
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Only needed if your project still signs tokens with the legacy JWT secret
# (Project Settings -> API -> JWT Settings). Newer projects are verified through the project's public keys.
SUPABASE_JWT_SECRET=your_jwt_secret

# Reminder / booking emails (optional; nothing is sent without SMTP_USERNAME and SMTP_PASSWORD)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Protects /api/cron/reminders. Generate with: openssl rand -hex 32
CRON_SECRET=

# Leave unset: the API is served by this same app. Only set it if the API is hosted elsewhere.
# NEXT_PUBLIC_BACKEND_URL=
